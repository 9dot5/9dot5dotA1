{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch --show-current)",
      "Bash(gh pr merge:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- :*)",
      "Bash(git restore:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh auth refresh -s delete_repo:*)",
      "Bash(gh auth refresh --scopes delete_repo:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(rm:*)",
      "Edit(CODEOWNERS)",
      "Edit(LICENSE)",
      "Edit(.claude/**)",
      "Edit(scripts/**)",
      "Edit(~/.9dot5dotA1/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_audit.py\" pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent_audit.py\" post"
          }
        ]
      }
    ]
  }
}
